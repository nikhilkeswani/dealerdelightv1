# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Get this from your Replit database connection (PostgreSQL)
# In Replit: Tools → Database → Copy Connection String
# Format: postgresql://username:password@host:port/database?sslmode=require
# Example: postgresql://user:pass@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_database_url_here

# ============================================================================
# EMAIL SERVICE (Resend)
# ============================================================================
# Resend API Key - Get from Replit Secrets (🔒 lock icon) or create new at https://resend.com/api-keys
# Format: re_YourApiKey123...
RESEND_API_KEY=your_resend_api_key_here

# Resend From Email - The verified email address you'll send emails from
# Get from Replit Secrets or verify a new one at https://resend.com/domains
# This email MUST be verified in your Resend account
# Example: noreply@yourdomain.com
RESEND_FROM_EMAIL=your_verified_email@yourdomain.com

# ============================================================================
# GOOGLE CLOUD STORAGE (Object Storage)
# ============================================================================
# Google Cloud Project ID
# Get from Replit Secrets or Google Cloud Console: https://console.cloud.google.com
# Example: my-project-123456
GCP_PROJECT_ID=your_gcp_project_id_here

# Google Cloud Service Account Credentials
# Download JSON key file from Google Cloud Console:
# 1. Go to: IAM & Admin → Service Accounts
# 2. Create/select service account with "Storage Object Admin" role
# 3. Keys → Add Key → Create New Key → JSON
# 4. Save as 'service-account-key.json' in project root
# Path relative to project root (or absolute path)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Public Object Search Paths (comma-separated)
# Get from Replit Secrets: PUBLIC_OBJECT_SEARCH_PATHS
# Format: gs://bucket-name/path/to/directory
# Example: gs://my-bucket/public
# Multiple paths: gs://bucket1/public,gs://bucket2/assets
PUBLIC_OBJECT_SEARCH_PATHS=gs://your-bucket-name/public

# Private Object Directory
# Get from Replit Secrets: PRIVATE_OBJECT_DIR
# Format: gs://bucket-name/path/to/directory
# Example: gs://my-bucket/private
PRIVATE_OBJECT_DIR=gs://your-bucket-name/private

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Admin Password - Used for /api/admin/login endpoint
# Get from Replit Secrets: ADMIN_PASSWORD
# Set a strong password for admin access
ADMIN_PASSWORD=your_secure_admin_password_here

# Session Secret - Used for encrypting session cookies
# ⚠️ CRITICAL: MUST be unique and secret in production!
# Generate a new secure secret: openssl rand -hex 32
# Never use the default value in production!
SESSION_SECRET=REPLACE_WITH_YOUR_OWN_GENERATED_SECRET_DO_NOT_USE_THIS_VALUE

# Allowed Origins for CORS (comma-separated)
# In production, list only your actual domain(s)
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave empty for development (allows all origins)
ALLOWED_ORIGINS=https://yourdomain.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment
# Set to 'production' when deploying, 'development' for local dev
NODE_ENV=development

