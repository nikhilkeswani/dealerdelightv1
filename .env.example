# =============================================================================
# DealerDelight Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
# 
# For Neon (recommended): Get this from your Neon project dashboard
# For local development: postgresql://postgres:password@localhost:5432/dealerdelight
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
# Secret key for session encryption - MUST be strong and unique in production!
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# OBJECT STORAGE CONFIGURATION (Google Cloud Storage)
# =============================================================================
# Comma-separated list of public object storage paths
# Example: gs://your-bucket-name/public,gs://another-bucket/assets
PUBLIC_OBJECT_SEARCH_PATHS=gs://your-bucket-name/public

# Private object storage directory
# Example: gs://your-bucket-name/private
PRIVATE_OBJECT_DIR=gs://your-bucket-name/private

# Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Path to Google Cloud service account key JSON file (for local development)
# In production, use workload identity or other authentication methods
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# Password for admin panel access at /admin
# Generate a strong password for production!
ADMIN_PASSWORD=your-secure-admin-password

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the server to listen on (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# REPLIT-SPECIFIC (Only needed on Replit platform)
# =============================================================================
# These are automatically set by Replit, do not set manually
# REPL_ID=
# REPL_IDENTITY=
# WEB_REPL_RENEWAL=
# REPLIT_CONNECTORS_HOSTNAME=
