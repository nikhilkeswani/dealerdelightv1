# =============================================================================
# DealerDelight Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# REQUIRED: PostgreSQL connection string from Neon
# Format: postgresql://user:password@host:port/database?sslmode=require
# 
# TO GET FROM REPLIT:
# 1. Open your Replit project
# 2. Click "Tools" → "Database" (or database icon in sidebar)
# 3. Copy the "Connection String"
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
# REQUIRED: Secret key for session encryption - MUST be strong and unique!
# Generate a new one with: openssl rand -hex 32
# This is NEW - not in Replit, generate a fresh one
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================
# REQUIRED: Get your API key from Resend dashboard
# TO GET FROM REPLIT:
# 1. Click the lock icon (Secrets) in left sidebar
# 2. Find and copy RESEND_API_KEY value
# Or create new key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# REQUIRED: Email address to send from (must be verified in Resend)
# TO GET FROM REPLIT: Check Secrets panel or your Resend dashboard
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# OBJECT STORAGE CONFIGURATION (Google Cloud Storage)
# =============================================================================
# REQUIRED: Comma-separated list of public object storage paths
# Example: gs://your-bucket-name/public
# TO GET FROM REPLIT: Check Secrets panel for PUBLIC_OBJECT_SEARCH_PATHS
PUBLIC_OBJECT_SEARCH_PATHS=gs://your-bucket-name/public

# REQUIRED: Private object storage directory
# Example: gs://your-bucket-name/private
# TO GET FROM REPLIT: Check Secrets panel for PRIVATE_OBJECT_DIR
PRIVATE_OBJECT_DIR=gs://your-bucket-name/private

# REQUIRED: Google Cloud Project ID
# Find in: Google Cloud Console → Project Settings
# This is the project that owns your GCS buckets
GCP_PROJECT_ID=your-gcp-project-id

# REQUIRED: Path to service account key JSON file
# IMPORTANT STEPS:
# 1. Go to Google Cloud Console → IAM & Admin → Service Accounts
# 2. Find or create service account with "Storage Object Admin" role
# 3. Click "Keys" → "Add Key" → "Create New Key" → JSON
# 4. Download the JSON file
# 5. Place it in your project root as "service-account-key.json"
# 6. Reference it here (already in .gitignore - safe from commits!)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# REQUIRED: Password for admin panel access at /admin
# TO GET FROM REPLIT: Check Secrets panel for ADMIN_PASSWORD
# Or generate a new strong password for production
ADMIN_PASSWORD=your-secure-admin-password

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the server to listen on (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# REMOVED: Replit-Specific Variables (No Longer Needed!)
# =============================================================================
# These Replit variables have been REMOVED from the code:
# ❌ REPL_ID
# ❌ REPL_IDENTITY  
# ❌ WEB_REPL_RENEWAL
# ❌ REPLIT_CONNECTORS_HOSTNAME
#
# The app now uses standard authentication methods instead!
